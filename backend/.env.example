NODE_ENV=development
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=devlens
DB_PASSWORD=your_password_here
DB_NAME=devlens_db
DB_CONNECTION_LIMIT=10

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub Webhook Secret
# This is a secret string that YOU create (it is not issued by GitHub).
# DevLens uses it to verify that incoming webhook payloads genuinely come from GitHub.
# How it works:
#   1. You choose any long random string as the secret (e.g. run: openssl rand -hex 32).
#   2. You paste that same string here AND into the "Secret" field of your GitHub webhook
#      (repo → Settings → Webhooks → Add webhook).
#   3. GitHub signs every payload it sends using HMAC-SHA256 with this secret.
#   4. DevLens rejects any webhook request whose signature does not match.
# If this variable is left blank, signature verification is skipped (not recommended for production).
# Generate a secret: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Security
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Client origin (for CORS + OAuth redirects)
CLIENT_ORIGIN=http://localhost:3000

# Repo cloning limits
MAX_REPO_SIZE_MB=500
MAX_FILES_PER_REPO=5000
MAX_FILE_SIZE_BYTES=524288

# Chunking
CHUNK_SIZE_TOKENS=3000
CHUNK_OVERLAP_TOKENS=200
