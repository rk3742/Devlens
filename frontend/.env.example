# Backend API base URL (used by axios when running outside CRA proxy)
# In development, the CRA proxy in package.json handles this automatically.
# Only set this if deploying the frontend separately from the backend.
REACT_APP_BACKEND_URL=http://localhost:5000

# (Optional) Override the Gemini model the frontend references in descriptions
# This is informational only — the actual model is set on the backend.
